{
  "name": "retrograde",
  "version": "0.1.0",
  "private": true,
  "description": "RETROGRADE — a portfolio you boot, not browse. See DESIGN.md.",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "predev": "tsx scripts/bake.ts --offline",
    "dev": "next dev",
    "prebuild": "tsx scripts/bake.ts",
    "build": "next build",
    "postbuild": "node scripts/boot-manifest.mjs",
    "start": "next start",
    "bake": "tsx scripts/bake.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "fonts:bake": "sh scripts/fonts/run.sh",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run typecheck && npm run lint && npm run test",
    "weight": "node scripts/weight.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "motion": "^14.12.0",
    "next": "16.4.6",
    "postprocessing": "^6.39.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "^0.187.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "d3-force-3d": "^3.0.6",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "postcss": "^8.5.6",
    "simple-icons": "^16.37.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
