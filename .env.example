# RETROGRADE — environment (copy to .env.local for local use; set them in Vercel for a deploy).
# Nothing here is needed to build or browse the site: without the contact keys, CONNECT's form
# answers 503 and offers mailto instead (it fails closed, DESIGN.md §7.4 CONNECT).

# ── the site's address ───────────────────────────────────────────────────────────────────────────
# Its own domain, once it has one: canonicals, Open Graph, JSON-LD and the sitemap are built on it.
# Unset on Vercel, it's the project's production URL (VERCEL_PROJECT_PRODUCTION_URL); unset locally,
# http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# ── CONNECT's form (app/api/contact/route.ts) ────────────────────────────────────────────────────
# Resend (https://resend.com): an API key with "sending" access.
RESEND_API_KEY=
# Upstash Redis (https://upstash.com), for the rate limit: 3 messages per 10 minutes per IP.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Where messages go (default: the profile's email in content/data.ts).
CONTACT_TO=
# Who they're from (default: Resend's onboarding sender, which can only write to the account's own
# address: verify a domain in Resend and name a sender on it, e.g. "RETROGRADE <hello@your.domain>").
CONTACT_FROM=

# ── local review only (never set in production) ─────────────────────────────────────────────────
# RETROGRADE_DEV_ROUTES=1      serve /dev/* from a production build (the gates use them)
# RETROGRADE_BUILD_DATE=YYYY-MM-DD   pin "today" for the bake and derive()
